{
  "name": "terminal-client",
  "version": "1.0.0",
  "description": "Web terminal client using xterm.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=dist/app.js --minify --sourcemap",
    "dev": "esbuild src/app.ts --bundle --outfile=dist/app.js --sourcemap --watch"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
