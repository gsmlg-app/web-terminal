{
  "name": "terminal-client",
  "version": "1.0.0",
  "description": "Web terminal client using xterm.js",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check": "tsc --noEmit",
    "build": "esbuild src/app.ts --bundle --outfile=dist/app.js --minify --sourcemap",
    "dev": "esbuild src/app.ts --bundle --outfile=dist/app.js --sourcemap --watch"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
